{
  "name": "elo-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --project demo-elo-phase-1 --only firestore,storage \"npm run test:rules:run\"",
    "test:rules:run": "vitest run tests/firestore.rules.test.ts",
    "admin:claim": "node scripts/set-admin-claim.mjs",
    "admin:backfill-profiles": "node scripts/backfill-public-profiles.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
