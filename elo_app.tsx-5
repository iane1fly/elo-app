export const Badge = ({ children, className = '' }: { children: React.ReactNode; className?: string }) => (
  <span className={`px-2.5 py-1 text-xs font-medium rounded-full ${className}`} style={{ backgroundColor: 'var(--surface-subtle)', color: 'var(--text-secondary)' }}>
    {children}
  </span>
);

const FeedView = ({ feedPosts, newsList, newsLoading, newsError, onOpenProfile, onLikePost }: any) => (
  <div className="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <div className="hidden lg:block lg:col-span-1 space-y-6">
      <div className="rounded-2xl p-5 border shadow-sm sticky top-24" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
        <h3 className="font-semibold flex items-center gap-2 mb-4 text-sm"><Newspaper size={16} style={{ color: 'var(--text-secondary)' }}/> Radar de Mercado</h3>
        {newsLoading ? <div className="flex justify-center py-4"><Loader2 className="animate-spin" style={{ color: 'var(--text-secondary)' }} size={20} /></div> : 
         newsError || newsList.length === 0 ? <p className="text-xs text-center py-4" style={{ color: 'var(--text-secondary)' }}>Não foi possível carregar notícias.</p> :
         <div className="space-y-4">{newsList.map((news: any) => (
          <a key={news.id} href={news.url} target="_blank" rel="noopener noreferrer" className="block group">
            <h4 className="text-sm font-medium transition-colors line-clamp-2 leading-snug group-hover:opacity-70">{news.title}</h4>
            <p className="text-xs mt-1" style={{ color: 'var(--text-secondary)' }}>{news.time} • {news.source}</p>
          </a>
         ))}</div>}
      </div>
    </div>
    <div className="lg:col-span-2 space-y-6">
      {feedPosts.map((post: any) => (
        <div key={post.id} className="rounded-2xl p-5 border shadow-sm" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
          <div className="flex justify-between items-start mb-4">
            <div className="flex gap-3 items-center cursor-pointer group" onClick={() => onOpenProfile(post.author)}>
              <img src={post.author.avatar} className="w-10 h-10 rounded-full object-cover border" style={{ borderColor: 'var(--border)' }} />
              <div><h4 className="font-semibold text-sm group-hover:underline">{post.author.name}</h4><p className="text-xs" style={{ color: 'var(--text-secondary)' }}>{post.author.role}</p></div>
            </div>
            <span className="text-xs" style={{ color: 'var(--text-secondary)' }}>{post.time}</span>
          </div>
          <p className="text-sm mb-4 leading-relaxed whitespace-pre-wrap">{post.content}</p>
          {post.image && <div className="mb-4 rounded-xl overflow-hidden border" style={{ borderColor: 'var(--border)' }}><img src={post.image} className="w-full h-auto object-cover max-h-96" /></div>}
          {post.fileName && <div className="mb-4 flex items-center gap-3 p-3 rounded-xl border" style={{ backgroundColor: 'var(--surface-subtle)', borderColor: 'var(--border)' }}><Paperclip size={16} style={{ color: 'var(--text-secondary)' }}/><span className="text-sm font-medium">{post.fileName}</span></div>}
          <div className="flex gap-6 pt-4 border-t" style={{ borderColor: 'var(--border)' }}>
            <button 
              onClick={() => onLikePost(post.id)} 
              className={`flex items-center gap-1.5 text-xs font-medium hover:opacity-100 transition-colors ${post.likedByMe ? 'font-bold' : ''}`} 
              style={{ color: 'var(--text-secondary)' }}
            >
              <ThumbsUp size={16} className={post.likedByMe ? 'fill-current' : ''} /> {post.likes}
            </button>
            <button className="flex items-center gap-1.5 text-xs font-medium hover:opacity-100 transition-colors" style={{ color: 'var(--text-secondary)' }}><MessageCircle size={16} /> Comentar</button>
            <button className="flex items-center gap-1.5 text-xs font-medium hover:opacity-100 transition-colors ml-auto" style={{ color: 'var(--text-secondary)' }}><Share2 size={16} /> Partilhar</button>
          </div>
        </div>
      ))}
    </div>
    <div className="hidden lg:block lg:col-span-1 space-y-6">
      <div className="rounded-2xl p-5 border shadow-sm" style={{ backgroundColor: 'var(--surface-subtle)', borderColor: 'var(--border)' }}>
        <div className="flex items-center gap-2 mb-2" style={{ color: 'var(--text-primary)' }}><Lightbulb size={16} /><span className="font-semibold text-xs uppercase tracking-wider">Dica de {tipOfTheMonth.month}</span></div>
        <h4 className="font-bold mb-1 text-sm">{tipOfTheMonth.title}</h4>
        <p className="text-xs leading-relaxed opacity-80">{tipOfTheMonth.content}</p>
      </div>
    </div>
  </div>
);

const NetworkView = ({ users, onOpenProfile }: { users: UserProfile[]; onOpenProfile: (u: UserProfile) => void }) => {
  const [searchTerm, setSearchTerm] = useState('');

  const filteredUsers = users.filter(u => {
    const term = searchTerm.toLowerCase();
    return (
      (u.name && u.name.toLowerCase().includes(term)) ||
      (u.role && u.role.toLowerCase().includes(term)) ||
      (u.location && u.location.toLowerCase().includes(term))
    );
  });

  return (
    <div className="max-w-4xl mx-auto space-y-6">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <h2 className="text-xl font-bold">Rede Elo</h2>
        <div className="w-full sm:w-72 relative">
          <Search size={16} className="absolute left-3 top-1/2 -translate-y-1/2 opacity-50" />
          <input 
            type="text" 
            value={searchTerm} 
            onChange={e => setSearchTerm(e.target.value)} 
            placeholder="Pesquisar por nome, cargo ou local..." 
            className="w-full pl-9 pr-4 py-2 rounded-xl text-sm border bg-transparent focus:outline-none"
            style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }}
          />
        </div>
      </div>

      {filteredUsers.length === 0 ? (
        <div className="text-center py-12 rounded-2xl border" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
          <p className="text-sm" style={{ color: 'var(--text-secondary)' }}>Nenhum membro encontrado.</p>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          {filteredUsers.map((u) => (
            <div key={u.id} className="rounded-2xl p-5 border shadow-sm flex gap-4 items-start" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
              <img src={u.avatar} className="w-16 h-16 rounded-full object-cover border cursor-pointer shrink-0" style={{ borderColor: 'var(--border)' }} onClick={() => onOpenProfile(u)} />
              <div className="flex-1 min-w-0">
                <h3 className="font-semibold text-base cursor-pointer hover:underline truncate" onClick={() => onOpenProfile(u)}>{u.name}</h3>
                <p className="text-xs mb-2 truncate" style={{ color: 'var(--text-secondary)' }}>{u.role}</p>
                <div className="flex flex-wrap gap-1.5 mb-4">{u.lookingFor && u.lookingFor.slice(0,2).map((l, i) => <Badge key={i}>{l}</Badge>)}</div>
                <button onClick={() => onOpenProfile(u)} className="w-full py-1.5 rounded-lg text-xs font-medium border transition-colors hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer" style={{ borderColor: 'var(--border)' }}>Ver Perfil</button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
};

const NotificationsView = ({ notifications }: any) => (
  <div className="max-w-2xl mx-auto">
    <div className="rounded-2xl shadow-sm border overflow-hidden" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
      <div className="p-5 border-b flex items-center justify-between" style={{ borderColor: 'var(--border)' }}><h2 className="text-lg font-bold">Notificações</h2><button className="text-xs hover:underline opacity-70">Marcar todas como lidas</button></div>
      <div className="divide-y" style={{ borderColor: 'var(--border)' }}>
        {notifications.map((notif: any) => (
          <div key={notif.id} className="p-5 flex gap-4 hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer">
            <div className="relative shrink-0">
              <img src={notif.user.avatar} className="w-12 h-12 rounded-full object-cover" />
              <div className="absolute -bottom-1 -right-1 w-6 h-6 rounded-full flex items-center justify-center border-2 shadow-sm bg-black text-white dark:bg-white dark:text-black border-[var(--surface)]">
