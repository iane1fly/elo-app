export interface UserProfile {
  id: string; uid?: string; name: string; email: string; role: string; location: string;
  avatar: string; cover: string; about: string; lookingFor: string[];
  socials: { linkedin?: string; twitter?: string; github?: string; };
  projects: { id: string; title: string; description: string; url?: string; }[];
  following: string[]; isFounder: boolean; subscription: 'Standard' | 'Plus' | 'Pro';
  status?: 'pending' | 'approved' | 'rejected';
  visibleInNetwork?: boolean; acceptsMeetings?: boolean;
}

export interface PostItem { id: string; author: UserProfile; content: string; image?: string | null; fileName?: string | null; time: string; likes: number; likedByMe?: boolean; }
export interface NewsItem { id: string; source: string; title: string; time: string; url: string; }
export interface NotificationItem { id: string; type: 'follow' | 'meeting' | 'like'; user: UserProfile; time: string; text: string; }

