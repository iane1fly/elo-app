);

const ProfileView = ({ user, isCurrentUser, onEditProfile }: any) => (
  <div className="max-w-4xl mx-auto space-y-6 pb-12">
    <div className="rounded-3xl shadow-sm border overflow-hidden" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
      <div className="h-48 w-full relative"><img src={user.cover} className="w-full h-full object-cover" /><div className="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div></div>
      <div className="px-8 pb-8 relative">
        <div className="flex justify-between items-end -mt-16 mb-4">
          <img src={user.avatar} className="w-32 h-32 rounded-2xl border-4 object-cover" style={{ borderColor: 'var(--surface)', backgroundColor: 'var(--surface)' }} />
          <div className="flex gap-3">
            {isCurrentUser ? 
              <button onClick={onEditProfile} className="flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium shadow-sm transition-opacity hover:opacity-90 bg-black text-white dark:bg-white dark:text-black cursor-pointer"><PenSquare size={16} /> Editar</button> : 
              (user.acceptsMeetings !== false ? (
                <button className="flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium shadow-sm transition-opacity hover:opacity-90 bg-black text-white dark:bg-white dark:text-black cursor-pointer"><Calendar size={16} /> Reunião</button>
              ) : (
                <span className="text-xs italic" style={{ color: 'var(--text-secondary)' }}>Não aceita reuniões de momento</span>
              ))
            }
          </div>
        </div>
        <div>
          <h1 className="text-3xl font-bold flex items-center flex-wrap gap-3">
            {user.name}
            {user.isFounder && <span className="inline-flex items-center justify-center w-7 h-7 bg-black text-white dark:bg-white dark:text-black rounded-lg text-xs"><Link2 size={16} /></span>}
            {user.subscription === 'Pro' && <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-black text-white dark:bg-white dark:text-black"><Crown size={14} /> Pro</span>}
          </h1>
          <p className="text-lg mt-1" style={{ color: 'var(--text-secondary)' }}>{user.role}</p>
          <div className="flex items-center gap-2 mt-2 text-sm" style={{ color: 'var(--text-secondary)' }}><MapPin size={16} /> {user.location}</div>
        </div>
      </div>
    </div>
    <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div className="md:col-span-2 space-y-6">
        <div className="rounded-3xl p-8 shadow-sm border" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
          <h2 className="text-lg font-bold mb-4 flex items-center gap-2"><User size={20} style={{ color: 'var(--text-secondary)' }} /> Sobre</h2>
          <p className="text-sm leading-relaxed whitespace-pre-wrap">{user.about}</p>
        </div>
      </div>
      <div className="space-y-6">
        <div className="rounded-3xl p-6 shadow-sm border" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
          <h2 className="text-xs font-bold uppercase tracking-wider mb-4" style={{ color: 'var(--text-secondary)' }}>À Procura De</h2>
          <div className="flex flex-wrap gap-2">{user.lookingFor && user.lookingFor.map((tag: string, idx: number) => <Badge key={idx}>{tag}</Badge>)}</div>
        </div>
      </div>
    </div>
  </div>
);

export const CreatePostModal = ({ isOpen, onClose, currentUser, onAddPost }: any) => {
  const [postContent, setPostContent] = useState('');
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [fileName, setFileName] = useState<string | null>(null);

  useEffect(() => { if (isOpen) { setPostContent(''); setImagePreview(null); setFileName(null); } }, [isOpen]);
  if (!isOpen) return null;

  const handleSimulateUpload = (type: 'image' | 'file') => {
    if (type === 'image') { setImagePreview('https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&auto=format&fit=crop'); setFileName(null); } 
    else { setFileName('Pitch_Deck_Q4.pdf'); setImagePreview(null); }
  };
  const handlePost = () => {
    if (!postContent.trim() && !imagePreview && !fileName) return;
    onAddPost({ id: `f${Date.now()}`, author: currentUser, content: postContent, image: imagePreview, fileName: fileName, time: 'Agora mesmo', likes: 0, likedByMe: false });
    onClose();
  };

  return (
    <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div className="rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border animate-in fade-in zoom-in-95 duration-200" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
        <div className="p-5 border-b flex justify-between items-center" style={{ borderColor: 'var(--border)', backgroundColor: 'var(--surface-subtle)' }}><h3 className="font-semibold text-lg flex items-center gap-2"><PenSquare size={18} style={{ color: 'var(--text-secondary)' }} /> Criar Publicação</h3><button onClick={onClose} className="hover:opacity-85 cursor-pointer" style={{ color: 'var(--text-secondary)' }}><X size={20} /></button></div>
        <div className="p-5 space-y-4">
          <div className="flex gap-3"><img src={currentUser.avatar} alt="Avatar" className="w-10 h-10 rounded-full object-cover border" style={{ borderColor: 'var(--border)' }} /><textarea autoFocus value={postContent} onChange={(e) => setPostContent(e.target.value)} placeholder="O que tens em mente para a tua startup hoje?" className="w-full text-base resize-none focus:outline-none placeholder:opacity-50 bg-transparent min-h-[100px]" style={{ color: 'var(--text-primary)' }}/></div>
          {imagePreview && <div className="relative rounded-xl overflow-hidden border group"><img src={imagePreview} className="w-full h-48 object-cover" /><button onClick={() => setImagePreview(null)} className="absolute top-2 right-2 p-1.5 bg-black/50 text-white rounded-full opacity-80 hover:opacity-100"><X size={14} /></button></div>}
          {fileName && <div className="flex items-center justify-between p-3 rounded-xl border" style={{ backgroundColor: 'var(--surface-subtle)', borderColor: 'var(--border)' }}><div className="flex items-center gap-2 text-sm font-medium"><Paperclip size={16} /><span>{fileName}</span></div><button onClick={() => setFileName(null)} className="p-1"><X size={14} /></button></div>}
          <div className="flex items-center justify-between pt-3 border-t" style={{ borderColor: 'var(--border)' }}><div className="flex items-center gap-2"><button onClick={() => handleSimulateUpload('image')} className="p-2 rounded-full hover:opacity-85"><ImageIcon size={20} /></button><button onClick={() => handleSimulateUpload('file')} className="p-2 rounded-full hover:opacity-85"><Paperclip size={20} /></button></div><button onClick={handlePost} disabled={!postContent.trim() && !imagePreview && !fileName} className="px-6 py-2 rounded-full text-sm font-medium disabled:opacity-40 bg-black text-white dark:bg-white dark:text-black">Publicar</button></div>
        </div>
      </div>
    </div>
  );
};

export const EditProfileModal = ({ isOpen, onClose, currentUser, onSaveUser }: any) => {
  const [formData, setFormData] = useState({ name: '', role: '', location: '', about: '', lookingFor: '', linkedin: '', avatar: '', cover: '' });
  
  useEffect(() => {
    if (isOpen && currentUser) {
      setFormData({ name: currentUser.name || '', role: currentUser.role || '', location: currentUser.location || '', about: currentUser.about || '', lookingFor: currentUser.lookingFor ? currentUser.lookingFor.join(', ') : '', linkedin: currentUser.socials?.linkedin || '', avatar: currentUser.avatar || '', cover: currentUser.cover || '' });
    }
  }, [isOpen, currentUser]);

  if (!isOpen) return null;

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onSaveUser({ ...currentUser, ...formData, lookingFor: formData.lookingFor.split(',').map((s: string) => s.trim()).filter(Boolean), socials: { ...currentUser.socials, linkedin: formData.linkedin } });
    onClose();
  };

  return (
    <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div className="rounded-2xl shadow-xl w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh] border animate-in fade-in zoom-in-95 duration-200" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
        <div className="p-5 border-b flex justify-between items-center" style={{ borderColor: 'var(--border)', backgroundColor: 'var(--surface-subtle)' }}><h3 className="font-semibold text-lg flex items-center gap-2"><User size={18} style={{ color: 'var(--text-secondary)' }} /> Editar Perfil</h3><button onClick={onClose} className="hover:opacity-85" style={{ color: 'var(--text-secondary)' }}><X size={20} /></button></div>
        <form onSubmit={handleSubmit} className="p-6 overflow-y-auto space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="space-y-1"><label className="text-xs font-medium" style={{ color: 'var(--text-secondary)' }}>Nome</label><input required type="text" value={formData.name} onChange={e => setFormData({...formData, name: e.target.value})} className="w-full px-3 py-2 border rounded-xl text-sm bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }} /></div>
            <div className="space-y-1"><label className="text-xs font-medium" style={{ color: 'var(--text-secondary)' }}>Cargo</label><input required type="text" value={formData.role} onChange={e => setFormData({...formData, role: e.target.value})} className="w-full px-3 py-2 border rounded-xl text-sm bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }} /></div>
          </div>
          <div className="space-y-1"><label className="text-xs font-medium" style={{ color: 'var(--text-secondary)' }}>Localização</label><input required type="text" value={formData.location} onChange={e => setFormData({...formData, location: e.target.value})} className="w-full px-3 py-2 border rounded-xl text-sm bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }} /></div>
          <div className="space-y-1"><label className="text-xs font-medium" style={{ color: 'var(--text-secondary)' }}>Sobre</label><textarea required rows={3} value={formData.about} onChange={e => setFormData({...formData, about: e.target.value})} className="w-full px-3 py-2 border rounded-xl text-sm resize-none bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }} /></div>
          <div className="pt-3 flex justify-end gap-3 border-t" style={{ borderColor: 'var(--border)' }}><button type="button" onClick={onClose} className="px-4 py-2 rounded-xl text-sm font-medium" style={{ color: 'var(--text-secondary)' }}>Cancelar</button><button type="submit" className="px-5 py-2 rounded-xl text-sm font-medium shadow-sm bg-black text-white dark:bg-white dark:text-black">Guardar</button></div>
        </form>
      </div>
    </div>
  );
};

export const AdminDashboardModal = ({ isOpen, onClose }: { isOpen: boolean; onClose: () => void; }) => {
  const [pendingRequests, setPendingRequests] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (!isOpen || !db) return;
    const fetchRequests = async () => {
      setLoading(true);
      try {
        const q = query(collection(db, 'accessRequests'), where('status', '==', 'pending'));
        const snapshot = await getDocs(q);
        setPendingRequests(snapshot.docs.map(docItem => ({ id: docItem.id, ...docItem.data() })));
      } catch (err: any) { console.error(err); } finally { setLoading(false); }
    };
    fetchRequests();
  }, [isOpen]);

  if (!isOpen) return null;

  const handleUpdateStatus = async (id: string, newStatus: 'approved' | 'rejected') => {
    try { 
      await updateDoc(doc(db, 'accessRequests', id), { status: newStatus }); 
      setPendingRequests(prev => prev.filter(r => r.id !== id)); 
    } catch (err: any) { console.error(err); }
  };

  return (
    <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div className="rounded-2xl shadow-xl w-full max-w-3xl overflow-hidden flex flex-col max-h-[85vh] border" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
        <div className="p-5 border-b flex justify-between items-center" style={{ borderColor: 'var(--border)', backgroundColor: 'var(--surface-subtle)' }}><h3 className="font-semibold text-lg flex items-center gap-2"><ShieldCheck size={20} style={{ color: 'var(--text-primary)' }} /> Admin</h3><button onClick={onClose} style={{ color: 'var(--text-secondary)' }}><X size={20} /></button></div>
        <div className="p-6 overflow-y-auto flex-1">
          {loading ? <div className="py-12 flex justify-center"><Loader2 className="animate-spin" style={{ color: 'var(--text-secondary)' }} /></div> : pendingRequests.length === 0 ? <div className="py-12 text-center text-sm" style={{ color: 'var(--text-secondary)' }}>Nenhum pedido pendente.</div> : (
            <div className="space-y-3">{pendingRequests.map(req => (
              <div key={req.id} className="p-4 rounded-xl border flex justify-between items-center" style={{ borderColor: 'var(--border)' }}>
                <div><h4 className="font-semibold text-sm">{req.name}</h4><p className="text-xs" style={{ color: 'var(--text-secondary)' }}>{req.email}</p></div>
                <div className="flex gap-2">
                  <button onClick={() => handleUpdateStatus(req.id, 'approved')} className="px-4 py-2 bg-black text-white dark:bg-white dark:text-black rounded-xl text-xs">Aprovar</button>
                  <button onClick={() => handleUpdateStatus(req.id, 'rejected')} className="px-4 py-2 bg-transparent border-2 border-current rounded-xl text-xs" style={{ color: 'var(--text-primary)' }}>Rejeitar</button>
                </div>
              </div>
            ))}</div>
          )}
        </div>
      </div>
    </div>
  );
};

const SettingsModal = ({ isOpen, onClose, theme, setTheme, currentUser, firebaseUser }: any) => {
  const [activeTab, setActiveTab] = useState('appearance');
  
  const [newEmail, setNewEmail] = useState(firebaseUser?.email || '');
  const [emailStatus, setEmailStatus] = useState<string | null>(null);
  const [newPassword, setNewPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [passwordStatus, setPasswordStatus] = useState<string | null>(null);
  const [deleteConfirmText, setDeleteConfirmText] = useState('');
  const [deleteStatus, setDeleteStatus] = useState<string | null>(null);

  const [visibleInNetwork, setVisibleInNetwork] = useState(currentUser?.visibleInNetwork ?? true);
  const [acceptsMeetings, setAcceptsMeetings] = useState(currentUser?.acceptsMeetings ?? true);

  const [notifFollows, setNotifFollows] = useState(true);
  const [notifMeetings, setNotifMeetings] = useState(true);

  if (!isOpen) return null;

  const handleUpdateEmail = async (e: React.FormEvent) => {
    e.preventDefault(); setEmailStatus(null);
    try {
      await updateEmail(firebaseUser, newEmail);
      setEmailStatus('Email atualizado com sucesso.');
    } catch (err: any) {
      if (err.code === 'auth/requires-recent-login') {
        setEmailStatus('Erro: Sessão expirada. Termine sessão e volte a entrar para alterar o email.');
      } else {
        setEmailStatus(`Erro: ${err.message}`);
      }
    }
  };

  const handleUpdatePassword = async (e: React.FormEvent) => {
    e.preventDefault(); setPasswordStatus(null);
    if (newPassword !== confirmPassword) { setPasswordStatus('As passwords não coincidem.'); return; }
    try {
      await updatePassword(firebaseUser, newPassword);
      setPasswordStatus('Password alterada com sucesso.');
      setNewPassword(''); setConfirmPassword('');
    } catch (err: any) {
      if (err.code === 'auth/requires-recent-login') {
        setPasswordStatus('Erro: Sessão expirada. Termine sessão e volte a entrar para alterar a password.');
      } else {
        setPasswordStatus(`Erro: ${err.message}`);
      }
    }
  };

  const handleDeleteAccount = async () => {
    if (deleteConfirmText !== 'ELIMINAR') return;
    setDeleteStatus(null);
    try {
      await deleteDoc(doc(db, 'accessRequests', firebaseUser.uid));
      await deleteUser(firebaseUser);
    } catch (err: any) {
      if (err.code === 'auth/requires-recent-login') {
        setDeleteStatus('Erro: Sessão expirada. Termine sessão e volte a entrar para apagar a conta.');
      } else {
        setDeleteStatus(`Erro: ${err.message}`);
      }
    }
  };

  const handleTogglePrivacy = async (field: 'visibleInNetwork' | 'acceptsMeetings', val: boolean) => {
    if (field === 'visibleInNetwork') setVisibleInNetwork(val);
    if (field === 'acceptsMeetings') setAcceptsMeetings(val);
    try {
      await updateDoc(doc(db, 'accessRequests', firebaseUser.uid), { [field]: val });
    } catch (err) {
      console.error(err);
    }
  };

  return (
    <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div className="rounded-2xl shadow-xl w-full max-w-3xl flex flex-col md:flex-row max-h-[85vh] min-h-[60vh] border overflow-hidden animate-in fade-in zoom-in-95 duration-200" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
        <div className="w-full md:w-1/3 border-r p-4 flex flex-col" style={{ backgroundColor: 'var(--surface-subtle)', borderColor: 'var(--border)' }}>
          <h3 className="font-semibold text-lg mb-6">Definições</h3>
          <nav className="space-y-1">
            <button onClick={() => setActiveTab('appearance')} className={`w-full text-left px-3 py-2 rounded-lg text-sm font-medium transition-colors ${activeTab === 'appearance' ? 'bg-black/10 dark:bg-white/10' : 'opacity-70 hover:opacity-100'}`}>Aparência</button>
            <button onClick={() => setActiveTab('account')} className={`w-full text-left px-3 py-2 rounded-lg text-sm font-medium transition-colors ${activeTab === 'account' ? 'bg-black/10 dark:bg-white/10' : 'opacity-70 hover:opacity-100'}`}>Conta</button>
            <button onClick={() => setActiveTab('privacy')} className={`w-full text-left px-3 py-2 rounded-lg text-sm font-medium transition-colors ${activeTab === 'privacy' ? 'bg-black/10 dark:bg-white/10' : 'opacity-70 hover:opacity-100'}`}>Privacidade</button>
            <button onClick={() => setActiveTab('notifications')} className={`w-full text-left px-3 py-2 rounded-lg text-sm font-medium transition-colors ${activeTab === 'notifications' ? 'bg-black/10 dark:bg-white/10' : 'opacity-70 hover:opacity-100'}`}>Notificações</button>
          </nav>
        </div>
        <div className="w-full md:w-2/3 p-6 relative overflow-y-auto">
          <button onClick={onClose} className="absolute top-4 right-4 opacity-50 hover:opacity-100 cursor-pointer"><X size={20} /></button>
          
          {activeTab === 'appearance' && (
            <div className="space-y-6">
              <h3 className="font-bold text-xl mb-4">Aparência</h3>
              <div className="space-y-3">
                <label className="text-sm font-medium uppercase tracking-wider" style={{ color: 'var(--text-secondary)' }}>Tema</label>
                <div className="grid grid-cols-2 gap-4">
                  <button onClick={() => setTheme('light')} className={`p-4 rounded-xl border-2 flex flex-col items-center gap-2 transition-all cursor-pointer ${theme === 'light' ? 'border-black dark:border-white' : 'border-transparent'}`} style={{ backgroundColor: 'var(--surface-subtle)' }}><span className="font-medium text-sm">Claro</span></button>
                  <button onClick={() => setTheme('dark')} className={`p-4 rounded-xl border-2 flex flex-col items-center gap-2 transition-all cursor-pointer ${theme === 'dark' ? 'border-black dark:border-white' : 'border-transparent'}`} style={{ backgroundColor: 'var(--surface-subtle)' }}><span className="font-medium text-sm">Escuro</span></button>
                </div>
              </div>
            </div>
          )}

          {activeTab === 'account' && (
            <div className="space-y-6 pb-6">
              <h3 className="font-bold text-xl mb-4">Conta</h3>
              
              <form onSubmit={handleUpdateEmail} className="space-y-3 p-4 rounded-xl border" style={{ borderColor: 'var(--border)' }}>
                <h4 className="font-semibold text-sm">Alterar Email</h4>
                <input type="email" value={newEmail} onChange={e => setNewEmail(e.target.value)} className="w-full px-3 py-2 rounded-xl text-sm border bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }} required />
                <button type="submit" className="px-4 py-2 rounded-xl text-xs font-medium bg-black text-white dark:bg-white dark:text-black cursor-pointer">Atualizar Email</button>
                {emailStatus && <p className="text-xs mt-1" style={{ color: 'var(--text-secondary)' }}>{emailStatus}</p>}
              </form>

              <form onSubmit={handleUpdatePassword} className="space-y-3 p-4 rounded-xl border" style={{ borderColor: 'var(--border)' }}>
                <h4 className="font-semibold text-sm">Alterar Password</h4>
                <input type="password" placeholder="Nova password" value={newPassword} onChange={e => setNewPassword(e.target.value)} className="w-full px-3 py-2 rounded-xl text-sm border bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }} required />
                <input type="password" placeholder="Confirmar nova password" value={confirmPassword} onChange={e => setConfirmPassword(e.target.value)} className="w-full px-3 py-2 rounded-xl text-sm border bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }} required />
                <button type="submit" className="px-4 py-2 rounded-xl text-xs font-medium bg-black text-white dark:bg-white dark:text-black cursor-pointer">Atualizar Password</button>
                {passwordStatus && <p className="text-xs mt-1" style={{ color: 'var(--text-secondary)' }}>{passwordStatus}</p>}
              </form>

              <div className="space-y-3 p-4 rounded-xl border-2 border-dashed" style={{ borderColor: 'var(--border)' }}>
                <h4 className="font-bold text-sm">Zona de Perigo</h4>
                <p className="text-xs" style={{ color: 'var(--text-secondary)' }}>Para eliminar a sua conta permanentemente, escreva <span className="font-bold">ELIMINAR</span> abaixo:</p>
                <input type="text" placeholder="ELIMINAR" value={deleteConfirmText} onChange={e => setDeleteConfirmText(e.target.value)} className="w-full px-3 py-2 rounded-xl text-sm border bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }} />
                <button type="button" disabled={deleteConfirmText !== 'ELIMINAR'} onClick={handleDeleteAccount} className="px-4 py-2 rounded-xl text-xs font-medium border-2 border-current disabled:opacity-30 cursor-pointer" style={{ color: 'var(--text-primary)' }}>Apagar Conta Definitivamente</button>
                {deleteStatus && <p className="text-xs mt-1" style={{ color: 'var(--text-secondary)' }}>{deleteStatus}</p>}
              </div>
            </div>
          )}

          {activeTab === 'privacy' && (
            <div className="space-y-6">
              <h3 className="font-bold text-xl mb-4">Privacidade</h3>
              <div className="space-y-4">
                <div className="flex items-center justify-between p-4 rounded-xl border" style={{ borderColor: 'var(--border)' }}>
                  <div><h4 className="font-semibold text-sm">Perfil visível na Rede</h4><p className="text-xs" style={{ color: 'var(--text-secondary)' }}>Permitir que outros membros vejam o seu perfil na aba Rede.</p></div>
                  <input type="checkbox" checked={visibleInNetwork} onChange={e => handleTogglePrivacy('visibleInNetwork', e.target.checked)} className="w-4 h-4 cursor-pointer" />
                </div>
                <div className="flex items-center justify-between p-4 rounded-xl border" style={{ borderColor: 'var(--border)' }}>
                  <div><h4 className="font-semibold text-sm">Aceitar pedidos de reunião</h4><p className="text-xs" style={{ color: 'var(--text-secondary)' }}>Mostrar o botão de reunião no seu perfil público.</p></div>
                  <input type="checkbox" checked={acceptsMeetings} onChange={e => handleTogglePrivacy('acceptsMeetings', e.target.checked)} className="w-4 h-4 cursor-pointer" />
                </div>
              </div>
            </div>
          )}

          {activeTab === 'notifications' && (
            <div className="space-y-6">
              <h3 className="font-bold text-xl mb-4">Notificações</h3>
              <div className="space-y-4">
                <div className="flex items-center justify-between p-4 rounded-xl border" style={{ borderColor: 'var(--border)' }}>
                  <div><h4 className="font-semibold text-sm">Novos seguidores</h4><p className="text-xs" style={{ color: 'var(--text-secondary)' }}>Notificar quando alguém começar a segui-lo.</p></div>
                  <input type="checkbox" checked={notifFollows} onChange={e => setNotifFollows(e.target.checked)} className="w-4 h-4 cursor-pointer" />
                </div>
                <div className="flex items-center justify-between p-4 rounded-xl border" style={{ borderColor: 'var(--border)' }}>
                  <div><h4 className="font-semibold text-sm">Pedidos de reunião</h4><p className="text-xs" style={{ color: 'var(--text-secondary)' }}>Notificar quando receber um pedido de reunião.</p></div>
                  <input type="checkbox" checked={notifMeetings} onChange={e => setNotifMeetings(e.target.checked)} className="w-4 h-4 cursor-pointer" />
                </div>
                <p className="text-xs italic" style={{ color: 'var(--text-secondary)' }}>Notificações por email ainda não estão ativas.</p>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

const PlansModal = ({ isOpen, onClose }: any) => {
  if (!isOpen) return null;
  return (
    <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div className="rounded-3xl shadow-2xl w-full max-w-4xl p-6 md:p-10 relative border overflow-hidden animate-in fade-in zoom-in-95 duration-200" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
        <button onClick={onClose} className="absolute top-6 right-6 opacity-50 hover:opacity-100 cursor-pointer"><X size={24} /></button>
        <div className="text-center max-w-2xl mx-auto mb-10"><h2 className="text-3xl font-bold mb-4">Planos Elo</h2><p style={{ color: 'var(--text-secondary)' }}>O teu acesso é gerido centralmente. Conta Pro ativa.</p></div>
        <div className="max-w-md mx-auto border rounded-2xl p-6 flex flex-col relative shadow-xl" style={{ backgroundColor: 'var(--surface-subtle)', borderColor: 'var(--border)' }}>
          <div className="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-black text-white dark:bg-white dark:text-black px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide flex items-center gap-1 shadow-sm"><Crown size={12} /> Pro Ativo</div>
          <div className="text-3xl font-bold mb-4 text-center mt-4" style={{ color: 'var(--text-primary)' }}>Acesso Total</div>
          <ul className="space-y-3 mb-8 flex-1">
            <li className="flex items-center gap-2 text-sm"><Check size={16} style={{ color: 'var(--text-primary)' }} className="shrink-0"/> Networking Ilimitado</li>
            <li className="flex items-center gap-2 text-sm"><Check size={16} style={{ color: 'var(--text-primary)' }} className="shrink-0"/> Visibilidade de Fundador</li>
          </ul>
        </div>
      </div>
    </div>
  );
};

const AiAssistant = ({ isOpen, onClose }: any) => {
  const [messages, setMessages] = useState([{ sender: 'ai', text: 'Olá! Sou o assistente Elo. Posso ajudar a encontrar o parceiro ideal ou dar dicas de pitch?' }]);
  const [input, setInput] = useState('');
  const messagesEndRef = useRef<HTMLDivElement>(null);

  useEffect(() => { if (isOpen) messagesEndRef.current?.scrollIntoView({ behavior: "smooth" }); }, [messages, isOpen]);
  if (!isOpen) return null;

  const handleSend = (e: React.FormEvent) => {
    e.preventDefault(); if (!input.trim()) return;
    setMessages(prev => [...prev, { sender: 'user', text: input }]);
    setInput('');
    setTimeout(() => { setMessages(prev => [...prev, { sender: 'ai', text: '[Em breve: Integração de IA para responder à tua questão]' }]); }, 1000);
  };

  return (
    <div className="fixed bottom-20 right-4 md:bottom-6 md:right-6 w-80 md:w-96 rounded-2xl shadow-2xl border flex flex-col h-[450px] z-40 animate-in slide-in-from-bottom-5" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
      <div className="p-4 flex justify-between items-center rounded-t-2xl bg-black text-white dark:bg-white dark:text-black"><div className="flex items-center gap-2"><Bot size={18} /><h3 className="font-semibold text-sm">Assistente Elo</h3></div><button onClick={onClose} className="hover:opacity-80 cursor-pointer"><X size={18} /></button></div>
      <div className="flex-1 p-4 overflow-y-auto space-y-4" style={{ backgroundColor: 'var(--surface-subtle)' }}>
        {messages.map((msg, i) => (
          <div key={i} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
            <div className={`max-w-[85%] p-3 rounded-2xl text-sm leading-relaxed border shadow-sm ${msg.sender === 'user' ? 'bg-black text-white dark:bg-white dark:text-black border-transparent rounded-br-none' : 'rounded-bl-none'}`} style={msg.sender === 'user' ? {} : { backgroundColor: 'var(--surface)', borderColor: 'var(--border)', color: 'var(--text-primary)' }}>{msg.text}</div>
          </div>
        ))}
        <div ref={messagesEndRef} />
      </div>
      <form onSubmit={handleSend} className="p-3 border-t flex items-center gap-2" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
        <input type="text" value={input} onChange={(e) => setInput(e.target.value)} placeholder="Pergunta algo..." className="flex-1 px-4 py-2 rounded-full text-sm focus:outline-none border bg-transparent" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }}/>
        <button type="submit" className="p-2 rounded-full transition-opacity hover:opacity-90 bg-black text-white dark:bg-white dark:text-black cursor-pointer"><Send size={16} className="ml-0.5" /></button>
      </form>
    </div>
  );
};

export const OnboardingView = ({ 
  onSignUpSubmit, 
  authLoading, 
  authError, 
  requestStatus, 
  onCancelRequest, 
  onLogout,
  onGoogleSignIn,
  onGithubSignIn,
  googleLoading,
  githubLoading,
  pendingOAuthUser,
  onCompleteOAuthProfile
}: any) => {
  const [step, setStep] = useState(pendingOAuthUser ? 2 : 1);
  const [formData, setFormData] = useState({ 
    name: pendingOAuthUser?.displayName || '', 
    email: pendingOAuthUser?.email || '', 
    password: '', 
    role: '', 
    location: '', 
    avatar: pendingOAuthUser?.photoURL || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop', 
    cover: 'https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=1200&auto=format&fit=crop', 
    about: '', 
    lookingFor: '' 
  });
  const [oauthNotice, setOauthNotice] = useState<string | null>(null);

  const handleNext = (e: React.FormEvent) => {
    e.preventDefault();
    if (pendingOAuthUser) {
      if (step < 4) {
        setStep(step + 1);
      } else {
        onCompleteOAuthProfile({ ...formData, lookingFor: formData.lookingFor.split(',').map((s: string) => s.trim()).filter(Boolean) });
      }
    } else {
      if (step < 4) {
        setStep(step + 1);
      } else {
        onSignUpSubmit({ ...formData, lookingFor: formData.lookingFor.split(',').map((s: string) => s.trim()).filter(Boolean) });
      }
    }
  };

  if (requestStatus === 'pending') {
    return (
      <div className="min-h-screen flex items-center justify-center p-4" style={{ backgroundColor: 'var(--bg)', color: 'var(--text-primary)' }}>
        <div className="max-w-sm w-full text-center space-y-8 animate-in fade-in duration-300">
          <div className="flex justify-center"><Logo /></div>
          <div className="w-16 h-16 rounded-full mx-auto flex items-center justify-center border-2" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }}><Clock3 size={32} className="animate-pulse" /></div>
          <div className="space-y-2">
            <h1 className="text-2xl font-semibold tracking-tight">Pedido enviado</h1>
            <p className="text-sm" style={{ color: 'var(--text-secondary)' }}>Aguarda aprovação pela moderação.</p>
          </div>
          <button onClick={onCancelRequest} className="w-full py-3 rounded-full text-sm font-medium border transition-colors hover:opacity-80 cursor-pointer" style={{ borderColor: 'var(--border)' }}>Terminar sessão</button>
        </div>
      </div>
    );
  }

  if (requestStatus === 'rejected') {
    return (
      <div className="min-h-screen flex items-center justify-center p-4" style={{ backgroundColor: 'var(--bg)', color: 'var(--text-primary)' }}>
        <div className="max-w-sm w-full text-center space-y-8 animate-in fade-in duration-300">
          <div className="flex justify-center"><Logo /></div>
          <div className="w-16 h-16 rounded-full mx-auto flex items-center justify-center border-2" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }}><ShieldAlert size={32} /></div>
          <div className="space-y-2"><h1 className="text-2xl font-semibold tracking-tight">Acesso não aprovado</h1></div>
          <button onClick={onLogout} className="w-full py-3 rounded-full font-medium transition-opacity hover:opacity-95 text-sm bg-black text-white dark:bg-white dark:text-black cursor-pointer">Voltar ao Início</button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen flex items-center justify-center p-4" style={{ backgroundColor: 'var(--bg)', color: 'var(--text-primary)' }}>
      <div className="max-w-sm w-full space-y-8 animate-in fade-in duration-300 my-8">
        
        <div className="flex items-center justify-between">
          {step > (pendingOAuthUser ? 2 : 1) ? (
            <button onClick={() => setStep(step - 1)} className="p-2 -ml-2 rounded-full hover:opacity-70 cursor-pointer" style={{ color: 'var(--text-primary)' }}>
              <ArrowLeft size={20} />
            </button>
          ) : <div className="w-5"></div>}

          <div className="flex gap-1.5 items-center">
            {[1, 2, 3, 4].map(s => (
              <div key={s} className={`h-1 rounded-full transition-all duration-300 ${step === s ? 'w-6 bg-black dark:bg-white' : 'w-1.5 bg-neutral-300 dark:bg-neutral-800'}`}></div>
            ))}
          </div>
          <div className="w-5"></div>
        </div>

        <div className="text-center space-y-3 flex flex-col items-center">
          <Logo />
          <h1 className="text-2xl font-semibold tracking-tight mt-2" style={{ color: 'var(--text-primary)' }}>
            {pendingOAuthUser ? 'Completar Perfil' : 'Criar Conta de Fundador'}
          </h1>
        </div>

        {oauthNotice && (
          <div className="p-3 rounded-xl text-xs border flex items-center gap-2" style={{ backgroundColor: 'var(--surface-subtle)', borderColor: 'var(--border)', color: 'var(--text-primary)' }}>
            <AlertCircle size={16} /><span>{oauthNotice}</span>
          </div>
        )}

        {!pendingOAuthUser && step === 1 && (
          <div className="space-y-4">
            <button 
              type="button" 
              onClick={onGoogleSignIn} 
              disabled={googleLoading}
              className="w-full flex items-center justify-center gap-3 py-3 px-4 rounded-xl font-medium border hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-sm cursor-pointer" 
              style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }}
            >
              {googleLoading ? <Loader2 size={18} className="animate-spin" /> : (
                <>
                  <svg className="w-4 h-4" viewBox="0 0 24 24"><path fill="currentColor" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/><path fill="currentColor" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.76-2.11-6.7-4.95H1.2v3.15C3.16 21.35 7.23 24 12 24z"/><path fill="currentColor" d="M5.3 14.25c-.24-.72-.38-1.49-.38-2.25s.14-1.53.38-2.25V6.6H1.2C.44 8.14 0 9.99 0 12s.44 3.86 1.2 5.4l4.1-3.15z"/><path fill="currentColor" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.23 0 3.16 2.65 1.2 6.6l4.1 3.15c.94-2.84 3.58-4.95 6.7-4.95z"/></svg>
                  Continuar com Google
                </>
              )}
            </button>

            <button 
              type="button" 
              onClick={onGithubSignIn} 
              disabled={githubLoading}
              className="w-full flex items-center justify-center gap-3 py-3 px-4 rounded-xl font-medium border hover:opacity-80 transition-opacity text-sm cursor-pointer bg-black text-white dark:bg-white dark:text-black border-transparent"
            >
              {githubLoading ? <Loader2 size={18} className="animate-spin" /> : (
                <>
                  <svg className="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02_0 0024 12c0-6.63-5.37-12-12-12z"/></svg> Continuar com GitHub
                </>
              )}
            </button>

            <button type="button" onClick={() => setOauthNotice('Autenticação com Apple requer configuração adicional.')} className="w-full text-center text-xs underline opacity-70 hover:opacity-100 py-1 cursor-pointer">
              Continuar com Apple
            </button>

            <div className="relative flex py-2 items-center"><div className="flex-grow border-t" style={{ borderColor: 'var(--border)' }}></div><span className="flex-shrink mx-4 text-xs uppercase tracking-wider" style={{ color: 'var(--text-secondary)' }}>ou email</span><div className="flex-grow border-t" style={{ borderColor: 'var(--border)' }}></div></div>
          </div>
        )}

        <form onSubmit={handleNext} className="space-y-6">
          {(!pendingOAuthUser && step === 1) && (
            <div className="space-y-6 animate-in fade-in duration-200">
              <div className="space-y-1">
                <label className="text-xs font-light tracking-wide" style={{ color: 'var(--text-secondary)' }}>Email</label>
                <input required type="email" value={formData.email} onChange={e => setFormData({...formData, email: e.target.value})} className="w-full py-2.5 text-base bg-transparent border-b border-neutral-300 dark:border-neutral-700 focus:border-black dark:focus:border-white focus:outline-none transition-colors" style={{ color: 'var(--text-primary)' }} placeholder="nome@exemplo.pt" />
              </div>
              <div className="space-y-1">
                <label className="text-xs font-light tracking-wide" style={{ color: 'var(--text-secondary)' }}>Password</label>
                <input required type="password" value={formData.password} onChange={e => setFormData({...formData, password: e.target.value})} className="w-full py-2.5 text-base bg-transparent border-b border-neutral-300 dark:border-neutral-700 focus:border-black dark:focus:border-white focus:outline-none transition-colors" style={{ color: 'var(--text-primary)' }} placeholder="••••••••" />
              </div>
            </div>
          )}

          {((pendingOAuthUser && step === 2) || (!pendingOAuthUser && step === 2)) && (
            <div className="space-y-6 animate-in fade-in duration-200">
              <div className="space-y-1">
                <label className="text-xs font-light tracking-wide" style={{ color: 'var(--text-secondary)' }}>Nome Completo</label>
                <input required type="text" value={formData.name} onChange={e => setFormData({...formData, name: e.target.value})} className="w-full py-2.5 text-base bg-transparent border-b border-neutral-300 dark:border-neutral-700 focus:border-black dark:focus:border-white focus:outline-none transition-colors" style={{ color: 'var(--text-primary)' }} placeholder="Tiago Silva" />
              </div>
              <div className="space-y-1">
                <label className="text-xs font-light tracking-wide" style={{ color: 'var(--text-secondary)' }}>Localização</label>
                <input required type="text" value={formData.location} onChange={e => setFormData({...formData, location: e.target.value})} className="w-full py-2.5 text-base bg-transparent border-b border-neutral-300 dark:border-neutral-700 focus:border-black dark:focus:border-white focus:outline-none transition-colors" style={{ color: 'var(--text-primary)' }} placeholder="Lisboa, Portugal" />
              </div>
            </div>
          )}

          {step === 3 && (
            <div className="space-y-6 animate-in fade-in duration-200">
              <div className="space-y-1">
                <label className="text-xs font-light tracking-wide" style={{ color: 'var(--text-secondary)' }}>Cargo e Empresa</label>
                <input required type="text" value={formData.role} onChange={e => setFormData({...formData, role: e.target.value})} className="w-full py-2.5 text-base bg-transparent border-b border-neutral-300 dark:border-neutral-700 focus:border-black dark:focus:border-white focus:outline-none transition-colors" style={{ color: 'var(--text-primary)' }} placeholder="Fundador @ Elo" />
              </div>
              <div className="space-y-1">
                <label className="text-xs font-light tracking-wide" style={{ color: 'var(--text-secondary)' }}>Sobre Mim / Pitch</label>
                <textarea required rows={3} value={formData.about} onChange={e => setFormData({...formData, about: e.target.value})} className="w-full py-2.5 text-base bg-transparent border-b border-neutral-300 dark:border-neutral-700 focus:border-black dark:focus:border-white focus:outline-none resize-none transition-colors" style={{ color: 'var(--text-primary)' }} placeholder="Descreve a tua startup..." />
              </div>
            </div>
          )}

          {step === 4 && (
            <div className="space-y-6 animate-in fade-in duration-200">
              <div className="space-y-1">
                <label className="text-xs font-light tracking-wide" style={{ color: 'var(--text-secondary)' }}>O que procuras? (separado por vírgulas)</label>
                <input type="text" value={formData.lookingFor} onChange={e => setFormData({...formData, lookingFor: e.target.value})} className="w-full py-2.5 text-base bg-transparent border-b border-neutral-300 dark:border-neutral-700 focus:border-black dark:focus:border-white focus:outline-none transition-colors" style={{ color: 'var(--text-primary)' }} placeholder="Investidores, Cofundadores" />
              </div>
            </div>
          )}

          {authError && (
            <div className="flex items-center gap-2 text-xs font-medium" style={{ color: 'var(--text-primary)' }}>
              <AlertCircle size={14} className="shrink-0" /><span>{authError}</span>
            </div>
          )}

          <button type="submit" disabled={authLoading} className="w-full py-3.5 rounded-full font-medium transition-opacity hover:opacity-90 text-sm flex items-center justify-center gap-2 cursor-pointer bg-black text-white dark:bg-white dark:text-black disabled:opacity-50">
            {authLoading ? <Loader2 size={16} className="animate-spin" /> : (step < 4 ? 'Continuar' : 'Submeter Pedido de Acesso')}
          </button>
        </form>
      </div>
    </div>
  );
};

export default function App() {
  const [firebaseUser, setFirebaseUser] = useState<FirebaseUser | null>(null);
  const [authLoading, setAuthLoading] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);
  const [githubLoading, setGithubLoading] = useState(false);
  const [pendingOAuthUser, setPendingOAuthUser] = useState<FirebaseUser | null>(null);
  const [authError, setAuthError] = useState<string | null>(null);
  const [requestStatus, setRequestStatus] = useState<'pending' | 'rejected' | 'approved' | null>(null);
  const [currentUser, setCurrentUser] = useState<UserProfile | null>(null);
  
  const [theme, setTheme] = useState<'light' | 'dark'>(() => (localStorage.getItem('eloTheme') as 'light' | 'dark') || 'light');
  const [currentTab, setCurrentTab] = useState('feed');
  const [activeProfileId, setActiveProfileId] = useState<string | null>(null);
  const [feedPosts, setFeedPosts] = useState<PostItem[]>(initialMockFeed);
  
  const [approvedUsers, setApprovedUsers] = useState<UserProfile[]>([]);
  
  const [isPostModalOpen, setIsPostModalOpen] = useState(false);
  const [isEditProfileOpen, setIsEditProfileOpen] = useState(false);
  const [isAdminOpen, setIsAdminOpen] = useState(false);
  const [isSettingsOpen, setIsSettingsOpen] = useState(false);
  const [isPlansOpen, setIsPlansOpen] = useState(false);
  const [isAiOpen, setIsAiOpen] = useState(false);
  
  const [newsList, setNewsList] = useState<NewsItem[]>([]);
  const [newsLoading, setNewsLoading] = useState(false);
  const [newsError, setNewsError] = useState(false);

  useEffect(() => {
    const fetchLiveNews = async () => {
      setNewsLoading(true); setNewsError(false);
      try {
        const feeds = [{ url: 'https://eco.sapo.pt/feed/', name: 'ECO' }];
        const promises = feeds.map(feed => fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feed.url)}`).then(res => res.json()).then(data => data.items ? data.items.map((i: any) => ({ ...i, sourceName: feed.name })) : []).catch(() => []));
        const results = await Promise.all(promises);
        const combined = results.flat().sort((a: any, b: any) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());
        setNewsList(combined.slice(0, 5).map((item: any, idx: number) => ({ id: `live-${idx}`, source: item.sourceName || 'ECO', title: item.title, time: 'Recente', url: item.link })));
      } catch (e) { setNewsError(true); } finally { setNewsLoading(false); }
    };
    fetchLiveNews();
  }, []);

  useEffect(() => { 
    if (!auth) return;
    const unsub = onAuthStateChanged(auth, (user: FirebaseUser | null) => setFirebaseUser(user)); 
    return () => unsub(); 
  }, []);

  useEffect(() => {
    if (!firebaseUser || !db) { setRequestStatus(null); setCurrentUser(null); return; }
    const unsub = onSnapshot(doc(db, 'accessRequests', firebaseUser.uid), 
      async (docSnap) => {
        if (docSnap.exists()) {
          setPendingOAuthUser(null);
          const data = docSnap.data() as any;
          setRequestStatus(data.status);
          if (data.status === 'approved') {
            setCurrentUser({
              id: firebaseUser.uid, uid: firebaseUser.uid, name: data.name, email: data.email, role: data.role, location: data.location,
              avatar: data.avatar || firebaseUser.photoURL || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop',
              cover: data.cover || 'https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=1200&auto=format&fit=crop',
              about: data.about, lookingFor: data.lookingFor || [], socials: {}, projects: [], following: [], isFounder: true, subscription: 'Pro', status: 'approved',
              visibleInNetwork: data.visibleInNetwork ?? true, acceptsMeetings: data.acceptsMeetings ?? true
            });
          }
        } else if (firebaseUser && pendingOAuthUser?.uid !== firebaseUser.uid && !pendingOAuthUser) {
          try {
            const checkDoc = await getDoc(doc(db, 'accessRequests', firebaseUser.uid));
            if (!checkDoc.exists()) {
              setPendingOAuthUser(firebaseUser);
            }
          } catch (e) {
            setPendingOAuthUser(firebaseUser);
          }
        }
      },
      (err: any) => {
        if (err.code !== 'permission-denied') {
          console.error("Firestore error:", err);
        }
      }
    );
    return () => unsub();
  }, [firebaseUser, pendingOAuthUser]);

  useEffect(() => {
    if (!firebaseUser || !db) return;
    const q = query(collection(db, 'accessRequests'), where('status', '==', 'approved'));
    const unsub = onSnapshot(q, (snapshot: any) => {
      const users: UserProfile[] = [];
      snapshot.forEach((docSnap: any) => {
        const d = docSnap.data();
        if (d.visibleInNetwork !== false) {
          users.push({
            id: docSnap.id,
            uid: d.uid || docSnap.id,
            name: d.name,
            email: d.email,
            role: d.role,
            location: d.location,
            avatar: d.avatar,
            cover: d.cover,
            about: d.about,
            lookingFor: d.lookingFor || [],
            socials: {},
            projects: [],
            following: [],
            isFounder: true,
            subscription: 'Pro',
            status: 'approved',
            visibleInNetwork: d.visibleInNetwork ?? true,
            acceptsMeetings: d.acceptsMeetings ?? true
          });
        }
      });
      setApprovedUsers(users);
    }, (err: any) => {
      if (err.code !== 'permission-denied') {
        console.error("Network listener error:", err);
      }
    });
    return () => unsub();
  }, [firebaseUser]);

  useEffect(() => { localStorage.setItem('eloTheme', theme); document.documentElement.setAttribute('data-theme', theme); }, [theme]);

  const handleOAuthLogin = async (provider: any, setLoading: (v: boolean) => void) => {
    setLoading(true); setAuthError(null);
    try {
      const result = await signInWithPopup(auth, provider);
      const user = result.user;
      const docSnap = await getDoc(doc(db, 'accessRequests', user.uid));
      if (!docSnap.exists()) {
        setPendingOAuthUser(user);
      }
    } catch (err: any) {
      if (err.code !== 'auth/popup-closed-by-user') {
        setAuthError(err.message || "Erro na autenticação social.");
      }
    } finally {
      setLoading(false);
    }
  };

  const handleGoogleSignIn = () => handleOAuthLogin(new GoogleAuthProvider(), setGoogleLoading);
  const handleGithubSignIn = () => handleOAuthLogin(new GithubAuthProvider(), setGithubLoading);

  const handleCompleteOAuthProfile = async (formData: any) => {
    if (!firebaseUser) return;
    setAuthLoading(true); setAuthError(null);
    try {
      await setDoc(doc(db, 'accessRequests', firebaseUser.uid), {
        uid: firebaseUser.uid,
        name: formData.name,
        email: firebaseUser.email,
        role: formData.role,
        location: formData.location,
        about: formData.about,
        lookingFor: formData.lookingFor,
        avatar: formData.avatar || firebaseUser.photoURL || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop',
        cover: formData.cover,
        status: 'pending',
        createdAt: serverTimestamp(),
        visibleInNetwork: true,
        acceptsMeetings: true
      });
    } catch (err: any) {
      setAuthError(err.message || "Erro ao guardar perfil.");
    } finally {
      setAuthLoading(false);
    }
  };

  const handleSignUpSubmit = async (formData: any) => {
    setAuthLoading(true); setAuthError(null);
    try {
      let userCredential; let isNewUser = false;
      try {
        userCredential = await createUserWithEmailAndPassword(auth, formData.email, formData.password);
        isNewUser = true;
      } catch (authErr: any) {
        if (authErr.code === 'auth/email-already-in-use') { 
          userCredential = await signInWithEmailAndPassword(auth, formData.email, formData.password); 
        } else { 
          throw authErr; 
        }
      }
      const uid = userCredential?.user?.uid;
      if (!uid) throw new Error("Falha ao obter o identificador.");
      
      if (isNewUser) {
        await setDoc(doc(db, 'accessRequests', uid), { 
          uid, 
          name: formData.name, 
          email: formData.email, 
          role: formData.role, 
          location: formData.location, 
          about: formData.about, 
          lookingFor: formData.lookingFor, 
          avatar: formData.avatar, 
          cover: formData.cover, 
          status: 'pending', 
          createdAt: serverTimestamp(), 
          visibleInNetwork: true, 
          acceptsMeetings: true 
        });
      }
    } catch (err: any) { 
      setAuthError(err.message || "Ocorreu um erro no acesso."); 
    } finally { 
      setAuthLoading(false); 
    }
  };

  const handleLogout = async () => { await signOut(auth); setCurrentUser(null); setRequestStatus(null); setPendingOAuthUser(null); setCurrentTab('feed'); };
  
  const handleOpenProfile = (user: UserProfile) => {
    if (user.id === currentUser?.id) setCurrentTab('profile');
    else { setActiveProfileId(user.id); setCurrentTab('other-profile'); }
  };

  const handleLikePost = (postId: string) => {
    setFeedPosts(prev => prev.map(p => {
      if (p.id === postId) {
        const liked = !p.likedByMe;
        return {
          ...p,
          likedByMe: liked,
          likes: liked ? p.likes + 1 : p.likes - 1
        };
      }
      return p;
    }));
  };

  const combinedNetworkUsers = [...defaultMockUsers, ...approvedUsers.filter(u => u.id !== currentUser?.id && u.uid !== firebaseUser?.uid)];

  if (!firebaseUser || requestStatus !== 'approved' || !currentUser) {
    return (
      <div data-theme={theme} className="min-h-screen">
        <style dangerouslySetInnerHTML={{__html: `
          :root[data-theme="light"] { --bg: #ffffff; --surface: #ffffff; --surface-subtle: #f5f5f5; --border: #e5e5e5; --text-primary: #000000; --text-secondary: #737373; --accent: #000000; }
          :root[data-theme="dark"] { --bg: #000000; --surface: #0a0a0a; --surface-subtle: #171717; --border: #262626; --text-primary: #ffffff; --text-secondary: #a3a3a3; --accent: #ffffff; }
        `}} />
        <OnboardingView 
          onSignUpSubmit={handleSignUpSubmit} 
          authLoading={authLoading} 
          authError={authError} 
          requestStatus={requestStatus} 
          onCancelRequest={handleLogout} 
          onLogout={handleLogout}
          onGoogleSignIn={handleGoogleSignIn}
          onGithubSignIn={handleGithubSignIn}
          googleLoading={googleLoading}
          githubLoading={githubLoading}
          pendingOAuthUser={pendingOAuthUser}
          onCompleteOAuthProfile={handleCompleteOAuthProfile}
        />
      </div>
    );
  }

  return (
    <div data-theme={theme} className="min-h-screen pb-20 md:pb-8" style={{ backgroundColor: 'var(--bg)', color: 'var(--text-primary)' }}>
      <style dangerouslySetInnerHTML={{__html: `
        :root[data-theme="light"] { --bg: #ffffff; --surface: #ffffff; --surface-subtle: #f5f5f5; --border: #e5e5e5; --text-primary: #000000; --text-secondary: #737373; --accent: #000000; }
        :root[data-theme="dark"] { --bg: #000000; --surface: #0a0a0a; --surface-subtle: #171717; --border: #262626; --text-primary: #ffffff; --text-secondary: #a3a3a3; --accent: #ffffff; }
      `}} />
      
      <nav className="sticky top-0 z-30 border-b backdrop-blur-md hidden md:block" style={{ backgroundColor: 'var(--surface-subtle)', borderColor: 'var(--border)' }}>
        <div className="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
          <div onClick={() => setCurrentTab('feed')} className="cursor-pointer"><Logo /></div>
          <div className="flex items-center gap-2">
            {firebaseUser.uid === ADMIN_UID && <button onClick={() => setIsAdminOpen(true)} className="px-3 py-1.5 rounded-full text-xs font-medium bg-black text-white dark:bg-white dark:text-black shadow-sm flex items-center gap-1 cursor-pointer"><ShieldCheck size={14}/> Admin</button>}
            <button onClick={() => setIsPlansOpen(true)} className="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium border hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }}><Sparkles size={14} /> Planos</button>
            <button onClick={() => setIsPostModalOpen(true)} className="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium shadow-sm transition-opacity hover:opacity-90 bg-black text-white dark:bg-white dark:text-black cursor-pointer"><PenSquare size={14} /> Criar Post</button>
            
            <div className="w-px h-6 mx-2" style={{ backgroundColor: 'var(--border)' }}></div>
            
            <button onClick={() => setCurrentTab('feed')} className={`p-2 rounded-xl transition-colors cursor-pointer ${currentTab === 'feed' ? 'bg-[var(--surface-subtle)]' : 'hover:opacity-70'}`} style={{ color: 'var(--text-primary)' }}><Home size={20}/></button>
            <button onClick={() => setCurrentTab('network')} className={`p-2 rounded-xl transition-colors cursor-pointer ${currentTab === 'network' ? 'bg-[var(--surface-subtle)]' : 'hover:opacity-70'}`} style={{ color: 'var(--text-primary)' }}><Users size={20}/></button>
            <button onClick={() => setCurrentTab('notifications')} className={`p-2 rounded-xl transition-colors cursor-pointer relative ${currentTab === 'notifications' ? 'bg-[var(--surface-subtle)]' : 'hover:opacity-70'}`} style={{ color: 'var(--text-primary)' }}><Bell size={20}/><span className="absolute top-1 right-2 w-2 h-2 rounded-full bg-black dark:bg-white"></span></button>
            
            <div className="w-px h-6 mx-2" style={{ backgroundColor: 'var(--border)' }}></div>

            <button onClick={() => setIsSettingsOpen(true)} className="p-2 rounded-xl hover:opacity-70 cursor-pointer" style={{ color: 'var(--text-primary)' }}><Settings size={20}/></button>
            <button onClick={() => setCurrentTab('profile')} className={`p-1 rounded-xl transition-all ring-black dark:ring-white cursor-pointer ${currentTab === 'profile' ? 'ring-2' : ''}`}><img src={currentUser.avatar} className="w-8 h-8 rounded-lg object-cover border" style={{ borderColor: 'var(--border)' }} /></button>
            <button onClick={handleLogout} className="p-2 hover:opacity-50 cursor-pointer" style={{ color: 'var(--text-primary)' }} title="Terminar sessão"><LogOut size={20}/></button>
          </div>
        </div>
      </nav>

      <nav className="sticky top-0 z-30 border-b backdrop-blur-md md:hidden flex justify-between items-center px-4 h-14" style={{ backgroundColor: 'var(--surface-subtle)', borderColor: 'var(--border)' }}>
        <Logo />
        <div className="flex gap-2">
           <button onClick={() => setIsPostModalOpen(true)} className="p-2 rounded-full bg-black text-white dark:bg-white dark:text-black"><PenSquare size={16}/></button>
           <button onClick={() => setIsSettingsOpen(true)} className="p-2 rounded-full border" style={{ borderColor: 'var(--border)', color: 'var(--text-primary)' }}><Settings size={16}/></button>
        </div>
      </nav>
      
      <main className="max-w-7xl mx-auto px-4 pt-6">
        {currentTab === 'feed' && <FeedView feedPosts={feedPosts} newsList={newsList} newsLoading={newsLoading} newsError={newsError} onOpenProfile={handleOpenProfile} onLikePost={handleLikePost} />}
        {currentTab === 'network' && <NetworkView users={combinedNetworkUsers} onOpenProfile={handleOpenProfile} />}
        {currentTab === 'notifications' && <NotificationsView notifications={mockNotifications} />}
        {currentTab === 'profile' && <ProfileView user={currentUser} isCurrentUser={true} onEditProfile={() => setIsEditProfileOpen(true)} />}
        {currentTab === 'other-profile' && activeProfileId && <ProfileView user={combinedNetworkUsers.find(u => u.id === activeProfileId) || currentUser} isCurrentUser={false} />}
      </main>

      <div className="fixed bottom-0 left-0 right-0 border-t md:hidden flex justify-around items-center h-16 z-30" style={{ backgroundColor: 'var(--surface)', borderColor: 'var(--border)' }}>
        <button onClick={() => setCurrentTab('feed')} className={`flex flex-col items-center gap-1 ${currentTab === 'feed' ? 'opacity-100' : 'opacity-50'}`} style={{ color: 'var(--text-primary)' }}><Home size={20}/><span className="text-[10px]">Início</span></button>
        <button onClick={() => setCurrentTab('network')} className={`flex flex-col items-center gap-1 ${currentTab === 'network' ? 'opacity-100' : 'opacity-50'}`} style={{ color: 'var(--text-primary)' }}><Users size={20}/><span className="text-[10px]">Rede</span></button>
        <button onClick={() => setCurrentTab('notifications')} className={`flex flex-col items-center gap-1 ${currentTab === 'notifications' ? 'opacity-100' : 'opacity-50'}`} style={{ color: 'var(--text-primary)' }}><Bell size={20}/><span className="text-[10px]">Notificações</span></button>
        <button onClick={() => setCurrentTab('profile')} className={`flex flex-col items-center gap-1 ${currentTab === 'profile' ? 'opacity-100' : 'opacity-50'}`} style={{ color: 'var(--text-primary)' }}><UserCircle size={20}/><span className="text-[10px]">Perfil</span></button>
      </div>

      <CreatePostModal isOpen={isPostModalOpen} onClose={() => setIsPostModalOpen(false)} currentUser={currentUser} onAddPost={(post: PostItem) => setFeedPosts([post, ...feedPosts])} />
      <EditProfileModal isOpen={isEditProfileOpen} onClose={() => setIsEditProfileOpen(false)} currentUser={currentUser} onSaveUser={async (updated: any) => { setCurrentUser(updated); await updateDoc(doc(db, 'accessRequests', firebaseUser.uid), { ...updated }); }} />
      <AdminDashboardModal isOpen={isAdminOpen} onClose={() => setIsAdminOpen(false)} />
      <SettingsModal isOpen={isSettingsOpen} onClose={() => setIsSettingsOpen(false)} theme={theme} setTheme={setTheme} currentUser={currentUser} firebaseUser={firebaseUser} />
      <PlansModal isOpen={isPlansOpen} onClose={() => setIsPlansOpen(false)} />
      <AiAssistant isOpen={isAiOpen} onClose={() => setIsAiOpen(false)} />
      
      {!isAiOpen && (
        <button onClick={() => setIsAiOpen(true)} className="fixed bottom-20 right-4 md:bottom-6 md:right-6 w-12 h-12 rounded-full shadow-xl flex items-center justify-center hover:scale-105 transition-transform z-40 bg-black text-white dark:bg-white dark:text-black cursor-pointer">
          <Bot size={22} />
        </button>
      )}
    </div>
  );
}
